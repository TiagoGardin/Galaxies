# Segredos
.env
.env.*
!.env.example

# Mídia baixada (vídeos, áudios, frames, thumbnails) — nunca versionar
data/media/
data/cache/

# Experimentos e artefatos grandes
mlruns/
mlartifacts/
models/*
!models/.gitkeep
# o artefato final é versionado: o agente e o servidor MCP rodam sem retreinar (11 MB)
!models/lgbm_final.joblib
!models/lgbm_final.json
# a v2 (servida desde 21/10/2026) também
!models/lgbm_v2.joblib
!models/lgbm_v2.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Sistema / editores
.DS_Store
.vscode/
.idea/

# Embeddings e artefatos derivados grandes (regeneráveis)
data/features/*.npy
# exceção: o embedding do gancho depende dos quadros do vídeo (~20 h de download para refazer)
!data/features/emb_gancho.npy
mlflow.db
data/features/*_log.txt

# Artefatos de treino do CatBoost
catboost_info/

# Teste prospectivo: atributos por vídeo em JSON (60 MB; versionados juntos em atributos_*.parquet) e logs
data/prospectivo/atributos/
data/prospectivo/*_log.txt
