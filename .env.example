# Copie para .env e preencha. Nunca commite o .env.

# YouTube Data API v3 (Google Cloud Console > Credenciais > Chave de API, restrita à YouTube Data API v3)
YOUTUBE_API_KEY=

# Gemini (Google AI Studio, free tier): VLM da rubrica e, se LLM_API_KEY ficar vazia, o subagente explicador
GEMINI_API_KEY=

# Opcionais
# LLM_API_KEY=            # outra chave do Gemini só para o explicador (separa as cotas)
# AGENTE_MODELO=gemini-3.5-flash,gemini-3.1-flash-lite   # modelos do explicador, em ordem de preferência
# GALAXIES_MODELO=models/lgbm_final.joblib             # artefato servido pelo agente
